#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        auto_mouse_layer: auto_mouse_layer {
            compatible = "zmk,input-behavior-tog-layer";
            #binding-cells = <1>;
            time-out-ms = <1000>;
            exit-on-interruption;
        };

        scroller: scroller {
            compatible = "zmk,input-behavior-touch-pad-scroll";
            #binding-cells = <0>;
            delay-ms = <0>;
            tap-ms = <5>;
        };

        touch_behavior_1: touch1 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey1";
            bindings = <&kp A>;
        };

        touch_behavior_2: touch2 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey2";
            bindings = <&kp B>;
        };

        touch_behavior_3: touch3 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey3";
            bindings = <&mo 1>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        /* ここが左エンコーダー用のスクロール動作定義です */
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    /* * 【重要】Orbee rev.2 の左右ビルドを通すための設定
     * trackball というラベルが存在する場合のみ、以下の設定を有効にします。
     */

    #if EXPOSE_TRACKBALL

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        bindings = <&auto_mouse_layer MOUSE>;
    };

    scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <MOUSE>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        bindings = <&scroller>;
        xy-multiplier = <1>;
    };

    #endif

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                   &kp W       &kp E    &kp R                &kp T                                                 &kp Y           &kp U  &kp I       &kp O    &kp P
&kp A                   &kp S       &kp D    &kp F                &kp G       &kp EQUAL                         &kp LS(LG(S))  &kp H           &kp J  &kp K       &kp L    &kp MINUS
&mt LEFT_SHIFT Z        &kp X       &kp C    &kp V                &kp B       &kp ESCAPE                       &kp LC(S)       &kp N           &kp M  &kp COMMA   &kp DOT  &mt RIGHT_SHIFT SLASH
&mt LCTRL INT_MUHENKAN  &kp LC(S)   &kp DEL  &lt 3 INT_MUHENKAN   &lt 2 TAB   &mt LEFT_SHIFT SPACE     &lt 1 ENTER     &kp BACKSPACE                                      &mt RIGHT_ALT INT_HENKAN
            >;

            /* * ここでエンコーダーの割り当てを行っています。
             * 1行目: encoder_left0 (スクショ左下) -> スクロール動作
             * 2行目: encoder_right (スクショ右下) -> 音量操作
             */
            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            bindings = <
&kp LESS_THAN         &kp GREATER_THAN       &kp DOLLAR      &kp PERCENT     &kp DOUBLE_QUOTES                       &kp TILDE  &kp N7         &kp N8         &kp N9         &kp PLUS
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN     &kp UNDERSCORE  &kp COLON             &trans     &trans  &kp EQUAL  &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp MINUS
&kp LESS_THAN         &kp GREATER_THAN       &kp AMPERSAND   &kp HASH        &kp SEMICOLON         &trans     &trans  &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans                &trans                 &trans          &trans          &trans                &trans     &trans  &trans                                                  &kp ASTERISK
            >;
        };

        layer_2 {
            bindings = <
&kp F12  &kp F11  &kp F10  &kp F9  &kp PLUS                                                 &kp CARET         &kp AMPERSAND     &kp UP_ARROW     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp F8   &kp F7   &kp F6   &kp F5  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))     &trans  &kp PAGE_UP       &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp PAGE_DOWN
&kp F4   &kp F3   &kp F2   &kp F1  &kp PERIOD    &kp EQUAL                   &trans  &kp EXCLAMATION   &kp EXCLAMATION   &kp QUESTION     &kp TILDE               &kp BACKSLASH
&trans   &trans   &trans   &trans  &trans        &trans                      &trans  &trans                                                                           &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))       &kp UP_ARROW    &kp LC(TAB)                &trans                       &trans  &trans  &trans  &kp LESS_THAN         &kp GREATER_THAN
&kp HOME        &kp LEFT_ARROW        &kp DOWN_ARROW  &kp RIGHT_ARROW            &kp END  &trans     &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))    &trans   &trans     &trans  &trans  &trans  &trans  &kp LEFT_BRACKET       &kp RIGHT_BRACKET
&trans          &trans                &trans          &trans                     &trans   &trans     &trans  &trans                                            &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans     &trans        &trans         &trans         &trans         &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans     &bootloader   &trans         &trans         &trans         &trans         &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans     &trans        &trans                                                      &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &mkp MB1   &mkp MB2   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans                                  &trans
            >;
        };
    };
};
