#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    /* ▼▼▼ この aliases ブロックを丸ごと追加します ▼▼▼ */

    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    /* ▲▲▲ 追加箇所ここまで ▲▲▲ */

    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        auto_mouse_layer: auto_mouse_layer {
            compatible = "zmk,input-behavior-tog-layer";
            #binding-cells = <1>;
            time-out-ms = <10000>;
            exit-on-interruption;  /* ← コメントアウトを外し、有効化します */
        };

        scroller: scroller {
            compatible = "zmk,input-behavior-touch-pad-scroll";
            #binding-cells = <0>;
            delay-ms = <0>;
            tap-ms = <5>;
        };

        touch_behavior_1: touch1 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey1";
            bindings = <&kp A>;
        };

        touch_behavior_2: touch2 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey2";
            bindings = <&kp B>;
        };

        touch_behavior_3: touch3 {
            compatible = "zmk,behavior-momentary";
            label = "TouchKey3";
            bindings = <&mo 1>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        /* ロータリーエンコーダー用のスクロール設定 */

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            /* SCRL_UP / SCRL_DOWN はマウスホイールの動作です */

            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    /* * 【重要】Orbee rev.2 の左右ビルドを通すための設定 (そのまま維持) */

    #if EXPOSE_TRACKBALL

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <0>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        bindings = <&auto_mouse_layer MOUSE>;
    };

    scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <MOUSE>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        bindings = <&scroller>;
        xy-multiplier = <1>;
    };

    /* ▼▼▼ 追加箇所ここから ▼▼▼ */
    /* 特定レイヤー(例:2)でトラックボールをスクロールにする設定 */

    scroll_listener_layer2 {
        compatible = "zmk,input-behavior-listener";
        device = <&trackball>;
        layers = <5>;                /* ← 適用したいレイヤー番号を指定 */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        /* XYの動きをスクロールイベントに直接変換 */

        input-processors = <&zip_xy_to_scroll_mapper>;
    };

    /* ▲▲▲ 追加箇所ここまで ▲▲▲ */

    #endif

    keymap {
        compatible = "zmk,keymap";

        /* sensors = ... の行は削除してデフォルト定義を使用します */

        default_layer {
            bindings = <
&kp Q             &kp W      &kp E        &kp R        &kp T                                            &kp Y          &kp U  &kp I      &kp O    &lt 5 P
&kp A             &kp S      &kp D        &kp F        &kp G      &kp EQUAL               &lt 4 ESCAPE  &kp H          &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X      &kp C        &kp V        &kp B      &mkp LCLK               &mkp RCLK     &kp N          &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&lt 3 LANGUAGE_2  &kp RCTRL  &lt 7 LANG2  &lt 5 LANG1  &lt 2 TAB  &mt LEFT_SHIFT SPACE    &lt 1 ENTER   &kp BACKSPACE                             &mt RIGHT_ALT DEL
            >;

            /* ▼▼▼ ここを修正しました ▼▼▼
             * 1つ目と2つ目の両方にスクロール(&scroll_up_down)を割り当てました。
             * これで左右どちらのエンコーダーもスクロールとして動作するはずです。
             */

            sensor-bindings =
                <&inc_dec_kp LC(MINUS) LC(PLUS)>,
                <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp LESS_THAN         &kp GREATER_THAN       &kp DOLLAR     &kp PERCENT     &kp DOUBLE_QUOTES                                              &kp TILDE  &kp N7        &kp N8        &kp N9        &kp PLUS
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN    &kp UNDERSCORE  &kp COLON          &trans             &kp LG(LS(S))            &kp EQUAL  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp LESS_THAN         &kp GREATER_THAN       &kp AMPERSAND  &kp HASH        &kp SEMICOLON      &kp LC(LA(DEL))    &kp LG(LA(PRINTSCREEN))  &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans                &trans                 &trans         &trans          &trans             &trans             &trans                   &trans                                               &kp ASTERISK
            >;
        };

        layer_2 {
            bindings = <
&kp F12  &kp F11  &kp F10  &kp F9  &kp PLUS                                                &kp CARET         &kp DOUBLE_QUOTES  &kp UP_ARROW    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp F8   &kp F7   &kp F6   &kp F5  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))    &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT             &kp TILDE
&kp F4   &kp F3   &kp F2   &kp F1  &kp PERIOD    &trans                     &trans         &kp EXCLAMATION   &kp EXCLAMATION    &kp QUESTION    &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans   &trans   &trans   &trans  &trans        &trans                     &trans         &trans                                                                     &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans     &trans     &trans     &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(S)  &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(Z)  &kp LC(C)  &kp LC(V)  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans    &trans  &trans                          &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans        &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LA(LEFT)  &kp LA(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans        &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                             &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
